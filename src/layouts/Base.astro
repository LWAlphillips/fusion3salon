---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/global.css";
import site from "../content/site.json";

interface Props { title?: string; description?: string; image?: string; }
const { title, description, image = "/images/og.jpg" } = Astro.props;
const b = site.business;
const fullTitle = title ? `${title} | ${b.name} Pleasanton` : `${b.name} | Aveda & Davines Hair Salon in Pleasanton, CA`;
const desc = description ?? `Award-winning Aveda and Davines hair salon on Main Street in downtown Pleasanton since ${b.since}. Cuts, color, balayage, extensions and waxing. Book online.`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;

const nav = [
  { href: "/services/", label: "Services" },
  { href: "/specials/", label: "Specials" },
  { href: "/about-us/#team", label: "Team" },
  { href: "/about-us/", label: "About" },
  { href: "/about-us/careers/", label: "Careers" },
  { href: "/location/", label: "Visit" },
  { href: site.business.giftCardUrl, label: "Gift cards" },
];

const dayCodes: Record<string,string> = { Monday:"Mo", Tuesday:"Tu", Wednesday:"We", Thursday:"Th", Friday:"Fr", Saturday:"Sa", Sunday:"Su" };
const to24 = (t: string) => { const [hm, ap] = t.split(" "); let [h, m] = hm.split(":").map(Number); if (ap === "PM" && h !== 12) h += 12; if (ap === "AM" && h === 12) h = 0; return `${String(h).padStart(2,"0")}:${String(m).padStart(2,"0")}`; };
const schema = {
  "@context": "https://schema.org",
  "@type": "HairSalon",
  "@id": "https://fusion3salon.com/#salon",
  name: b.name,
  url: "https://fusion3salon.com/",
  image: "https://fusion3salon.com/images/og.jpg",
  logo: "https://fusion3salon.com/images/logo.png",
  telephone: b.phoneHref,
  email: b.email,
  foundingDate: String(b.since),
  priceRange: "$$",
  address: { "@type": "PostalAddress", streetAddress: b.street, addressLocality: b.city, addressRegion: b.state, postalCode: b.zip, addressCountry: "US" },
  openingHoursSpecification: site.hours.filter(h => h.open).map(h => ({ "@type": "OpeningHoursSpecification", dayOfWeek: `https://schema.org/${h.day}`, opens: to24(h.open), closes: to24(h.close) })),
  openingHours: site.hours.filter(h => h.open).map(h => `${dayCodes[h.day]} ${to24(h.open)}-${to24(h.close)}`),
  sameAs: Object.values(b.social),
  potentialAction: { "@type": "ReserveAction", target: b.bookingUrl },
};
const ann = site.announcement;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={b.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#1e3a2c" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <style>
    .announce { background: var(--color-forest); color: var(--color-on-dark); text-align: center; font-size: .95rem; padding: .55rem 1rem; }
    .announce a { color: var(--color-on-dark); font-weight: 600; }
    header.site { background: var(--color-bg); border-bottom: 1px solid var(--color-border); position: sticky; top: 0; z-index: 50; }
    .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .6rem 0; }
    .logo img { height: 58px; width: auto; }
    .nav-links { display: flex; align-items: center; gap: 1.6rem; }
    .nav-links a:not(.btn) { color: var(--color-text); text-decoration: none; font-weight: 500; padding: .5rem 0; }
    .nav-links a:not(.btn):hover, .nav-links a[aria-current="page"] { color: var(--color-brand); text-decoration: underline; text-decoration-thickness: 2px; }
    details.menu { display: none; }
    @media (max-width: 860px) {
      .nav-links.desktop { display: none; }
      details.menu { display: block; }
      details.menu summary { list-style: none; cursor: pointer; font-weight: 600; padding: .7rem 1rem; border: 2px solid var(--color-text); border-radius: var(--radius-button); min-height: 44px; }
      details.menu summary::-webkit-details-marker { display: none; }
      details.menu[open] .panel { position: absolute; left: 0; right: 0; top: 100%; background: var(--color-bg); border-bottom: 1px solid var(--color-border); padding: 1rem 1.25rem 1.5rem; }
      .panel .nav-links { flex-direction: column; align-items: stretch; gap: .25rem; }
      .panel .nav-links a:not(.btn) { padding: .7rem 0; font-size: 1.1rem; border-bottom: 1px solid var(--color-border); }
      .panel .btn { margin-top: .75rem; }
      .bar { position: relative; }
    }
    footer.site { background: var(--color-forest); color: var(--color-on-dark); padding: 3.5rem 0 2rem; font-size: .97rem; }
    footer.site a { color: var(--color-on-dark); }
    .foot-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2.5rem; }
    footer.site h2 { font-size: 1.15rem; font-family: var(--font-body); font-weight: 600; letter-spacing: .02em; margin-bottom: .8rem; }
    .awards { display: flex; gap: 1rem; align-items: center; margin-top: 1rem; }
    .awards img { height: 84px; width: auto; }
    .awards { background: var(--color-bg); border-radius: 12px; padding: 10px 14px; width: fit-content; }
    .legal { border-top: 1px solid rgba(244,241,232,.2); margin-top: 2.5rem; padding-top: 1.25rem; display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; justify-content: space-between; font-size: .9rem; }
    .legal ul { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
  </style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {ann.show && (
    <div class="announce" role="region" aria-label="Announcement">
      {ann.text} {ann.linkUrl && <a href={ann.linkUrl}>{ann.linkText}</a>}
    </div>
  )}
  <header class="site">
    <div class="wrap bar">
      <a class="logo" href="/"><img src="/images/logo.png" alt={`${b.name} home`} width="85" height="58" /></a>
      <nav class="nav-links desktop" aria-label="Main">
        {nav.map(n => <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>)}
        <a class="btn btn--primary" href={b.bookingUrl}>Book now</a>
      </nav>
      <details class="menu">
        <summary>Menu</summary>
        <div class="panel">
          <nav class="nav-links" aria-label="Main (mobile)">
            {nav.map(n => <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>)}
            <a class="btn btn--primary" href={b.bookingUrl}>Book now</a>
          </nav>
        </div>
      </details>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <h2>{b.name}</h2>
          <p>{b.street}<br />{b.city}, {b.state} {b.zip}</p>
          <p>Call <a href={`tel:${b.phoneHref}`}>{b.phone}</a><br />Text <a href={`sms:${b.textHref}`}>{b.text}</a><br /><a href={`mailto:${b.email}`}>{b.email}</a></p>
          <p><a href={b.mapUrl}>Get directions</a></p>
        </div>
        <div>
          <h2>Hours</h2>
          <table class="hours">
            <caption class="sr-only">Salon hours</caption>
            <tbody>
              {site.hours.map(h => <tr><th scope="row">{h.day}</th><td>{h.open ? `${h.open} – ${h.close}` : "Closed"}</td></tr>)}
            </tbody>
          </table>
        </div>
        <div>
          <h2>Stay in touch</h2>
          <ul class="list-clean">
            <li><a href={b.social.instagram}>Instagram</a></li>
            <li><a href={b.social.facebook}>Facebook</a></li>
            <li><a href={b.social.yelp}>Reviews on Yelp</a></li>
            <li><a href={b.giftCardUrl}>Gift cards</a></li>
          </ul>
          <div class="awards">
            <img src="/images/award-best-in-east-bay-2026.png" alt="East Bay Times Best in East Bay 2026 winner" width="91" height="84" loading="lazy" />
            <img src="/images/award-hall-of-fame-11-years.png" alt="East Bay Times Best of East Bay Hall of Fame, 11 years" width="100" height="84" loading="lazy" />
          </div>
        </div>
      </div>
      <div class="legal">
        <p style="margin:0">© {new Date().getFullYear()} {b.name}. Serving the Tri-Valley since {b.since}.</p>
        <ul class="list-clean">
          <li><a href="/accessibility/">Accessibility</a></li>
          <li><a href="/privacy-policy/">Privacy</a></li>
          <li><a href="/services/policies/">Salon policies</a></li>
          <li><a href="/blog/">Journal</a></li>
        </ul>
      </div>
    </div>
  </footer>
</body>
</html>
