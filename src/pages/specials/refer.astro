---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Voucher from "../../components/Voucher.astro";
import site from "../../content/site.json";
const v = site.vouchers.referral;
---
<Base title="Refer a Friend, Get $50" description="Refer a friend to Fusion 3 Salon in Pleasanton and receive a $50 salon credit after their first visit.">
  <PageHero title="Refer a friend, get $50" intro="Tap “Send to a friend” to share this voucher. When they come in and mention your name, you get a $50 salon credit." />
  <section class="section"><div class="wrap">
    <Voucher amount={v.amount} label="Friend referral" headline={v.headline} text={v.text} finePrint={v.finePrint} shareText={v.shareText} />
  </div></section>
</Base>
