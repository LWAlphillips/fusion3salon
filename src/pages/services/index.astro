---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import site from "../../content/site.json";
const s = site.services;
const book = site.business.bookingUrl;
---
<Base title="Hair Services: Cuts, Color, Balayage & Waxing" description="Haircuts, Aveda color, highlights, balayage, extensions, smoothing and waxing at Fusion 3 Salon in downtown Pleasanton. See services and book online.">
  <PageHero title="Services" intro="Cuts, color, extensions and waxing, all with Aveda and Davines products." />

  <section class="section intro-band">
    <div class="wrap">
      <nav aria-label="Service categories" class="jump">
        {s.groups.map(g => <a href={`#${g.id}`}>{g.name}</a>)}
        <a href="/services/policies/">Policies</a>
      </nav>
      <p class="note">{s.pricingNote}</p>
      <div class="btn-row"><a class="btn btn--primary" href={book}>See prices &amp; book</a></div>
    </div>
  </section>

  {s.groups.map((g, i) => (
    <section class={`group ${i % 2 === 0 ? "section--sand" : ""}`} id={g.id} aria-labelledby={`${g.id}-h`}>
      <div class="wrap group-grid">
        <div class="group-side">
          {g.image && <img src={g.image} alt={g.imageAlt} width="600" height="300" loading="lazy" />}
          <p class="eyebrow">{String(i + 1).padStart(2, "0")} · Services</p>
          <h2 id={`${g.id}-h`}>{g.name}</h2>
          <p class="muted">{g.intro}</p>
          <a class="btn btn--ghost" href={book}>Book {g.name.toLowerCase()}</a>
        </div>
        <ul class="list-clean menu">
          {g.items.map(it => (
            <li>
              <span class="item-name">{it.name}</span>
              {it.desc && <span class="item-desc">{it.desc}</span>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap"><div class="good">
      <h2>Good to know</h2>
      <ul class="list-clean checks">{s.extras.map(e => <li>{e}</li>)}</ul>
      <p><a href="/services/policies/">Read our booking and cancellation policies</a></p>
    </div></div>
  </section>
</Base>

<style>
  .intro-band { padding-bottom: 2.5rem; }
  .jump { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.5rem; }
  .jump a { padding: .5rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-button); text-decoration: none; background: var(--color-surface); }
  .jump a:hover { border-color: var(--color-brand); }
  .note { max-width: 44rem; color: var(--color-muted); }
  .group { padding: clamp(3rem, 6vw, 4.5rem) 0; scroll-margin-top: 80px; }
  .group-grid { display: grid; grid-template-columns: minmax(260px, 2fr) 3fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .group-side img { border-radius: var(--radius); width: 100%; aspect-ratio: 2 / 1; object-fit: cover; margin-bottom: 1.25rem; }
  .group-side .eyebrow { margin-bottom: .4rem; }
  .menu { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: .5rem 1.75rem; }
  .menu li { padding: 1rem 0; border-bottom: 1px solid var(--color-border); display: flex; flex-direction: column; gap: .15rem; }
  .menu li:last-child { border-bottom: 0; }
  .item-name { font-weight: 600; }
  .item-desc { color: var(--color-muted); }
  .good { max-width: 44rem; }
  @media (max-width: 800px) { .group-grid { grid-template-columns: 1fr; } .group-side img { max-height: 240px; } }
</style>
