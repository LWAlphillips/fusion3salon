---
import Base from "../layouts/Base.astro";
import posts from "../content/posts.json";
import site from "../content/site.json";
export function getStaticPaths() {
  return posts.map(p => ({ params: { post: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const fmt = (d: string) => new Date(d + "T12:00:00").toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<Base title={p.title} description={p.excerpt}>
  <article class="section">
    <div class="wrap prose">
      <p class="eyebrow"><a href="/blog/">Journal</a> · {fmt(p.date)}</p>
      <h1>{p.title}</h1>
      <div set:html={p.html} />
      <hr style="margin:3rem 0;border:0;border-top:1px solid var(--color-border)" />
      <p>Ready for a new look? <a href={site.business.bookingUrl}>Book with Fusion 3</a>.</p>
    </div>
  </article>
</Base>
