---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import site from "../../content/site.json";
const c = site.careers;
---
<Base title="Careers: Hair Stylist & Salon Jobs in Pleasanton" description="Join Fusion 3 Salon in Pleasanton. Hiring hair stylists, new talent stylists and salon coordinators at a team-based Aveda and Davines salon.">
  <PageHero title="Join our team" intro="Build your career at a team-based salon voted Best in East Bay." image="/images/banner-brick.webp" />
  <section class="section">
    <div class="wrap">
      <p class="lead">{c.intro}</p>
      <div class="grid grid--3" style="margin:2rem 0">
        {c.roles.map(r => <article class="card"><h2 style="font-size:1.4rem">{r.title}</h2><p>{r.text}</p></article>)}
      </div>
      <h2>How to apply</h2>
      <p>{c.applyText}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={`mailto:${site.business.email}?subject=Career%20inquiry`}>Email us your résumé</a>
        {c.applicationPdf && <a class="btn btn--ghost" href={c.applicationPdf}>Download application (PDF)</a>}
      </div>
    </div>
  </section>
</Base>
